<link rel="stylesheet" href="/css/dashboard/dashboard.css">

<body>
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-12">
                <h2 class="text-center mb-4">Dashboard General</h2>
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-xl-7 mb-4">
                <div class="card">
                    <div class="card-header text-white" style="background-color: #8a9db2;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Modificaciones por Mes</h6>
                            <select id="selectAnio" class="form-select form-select-sm" style="width: 100px;"></select>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="chart-container" style="position: relative; height: 450px;">
                            <canvas id="modificationsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5 mb-4">
                <div class="card h-100">
                    <div class="card-body p-3">
                        <div class="server-status-container mb-4">
                            <h5 class="card-title mb-2" style="font-size: 1.2rem;">Monitor del Servidor:</h5>
                            <div class="d-flex align-items-center">
                                <span id="server-status" class="server-status-text card-text fw-bold"
                                    style="font-size: 1rem; color: #28a745;">Óptimo</span>
                                <span id="server-status-icon" class="ms-2">
                                    <i class="fas fa-circle" style="font-size: 1rem; color: #28a745;"></i>
                                </span>
                            </div>
                        </div>

                        <div id="monitorInfo" class="small text-muted mb-4">
                            <div class="mb-3"><strong style="font-size: 1rem;">CPU:</strong> <span id="cpu-usage"
                                    style="font-size: 1rem;">0%</span></div>
                            <div class="mb-3"><strong style="font-size: 1rem;">Memoria:</strong> <span
                                    id="memory-usage" style="font-size: 1rem;">0 MB/0 MB</span></div>
                            <div><strong style="font-size: 1rem;">Últ. actualización:</strong> <span id="last-update"
                                    style="font-size: 1rem;">00:00:00</span></div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div style="position: relative;">
                            <canvas id="monitorChart" class="w-100" style="max-height: 400px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/controllers/dashboard/dashboard.js" defer></script>
</body>
